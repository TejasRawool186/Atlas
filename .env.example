# ============================================================
# ATLAS — AI Knowledge Integrity Auditor
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env with real secrets.

# ------------------------------------------------------------
# LLM Providers
# ------------------------------------------------------------

# Gemini API key (required for LLM-powered answer synthesis)
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key (optional alternative LLM provider)
# Obtain from: https://console.groq.com
GROQ_API_KEY=

# ------------------------------------------------------------
# Sanity Content Lake & Context MCP
# ------------------------------------------------------------

# Your Sanity project ID
# Find it at: https://www.sanity.io/manage
SANITY_PROJECT_ID=

# Sanity dataset name (typically "production")
SANITY_DATASET=production

# Sanity API version (ISO date format)
SANITY_API_VERSION=2024-01-01

# Sanity read token (required for authenticated queries)
# Create at: https://www.sanity.io/manage > API > Tokens
SANITY_API_TOKEN=

# Sanity Context MCP endpoint
SANITY_CONTEXT_URL=https://mcp.sanity.io/v1/context

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# HMAC-SHA256 secret for certificate signing (generate a strong random value)
# Example: openssl rand -hex 32
CERTIFICATE_HMAC_SECRET=

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

# Application port (default: 3000)
PORT=3000

# Application base URL (used for self-referential links)
APP_URL=http://localhost:3000
